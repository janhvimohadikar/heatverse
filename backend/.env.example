# Copy this file to ".env" (same folder) and edit it.  NEVER commit the real .env file.

# Generate a long random value with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me

# Frontend addresses that may call this API (comma separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# SQLite database file created by scripts/import_excel.py (default: ../database/heatverse.db)
# DATABASE_PATH=

# Live weather (Open-Meteo needs no API key). Set to false to disable.
LIVE_WEATHER_ENABLED=true
# Nearby hospitals (OpenStreetMap Overpass API, no key). Set to false to disable.
HOSPITALS_ENABLED=true

# Optional: path to a trained model file (joblib). Leave empty to use the DEMO predictor.
MODEL_PATH=
